# Copie para `.env` (ignorado pelo git). Só testes de rede leem estas variáveis;
# o app em produção não usa segredos de ambiente (contas ficam no cofre do SO).

# Nível de log (dev): trace | debug | info | warn | error
RUST_LOG=info

# Pasta de dados alternativa (dev/CLI). Vazio = pasta padrão do SO.
SWOOP_DATA_DIR=

# Testes de rede reais (#[ignore]) — preencher só na máquina do dono
SWOOP_TEST_FASTFILE_KEY=
SWOOP_TEST_PIXELDRAIN_KEY=
SWOOP_TEST_GOFILE_TOKEN=
